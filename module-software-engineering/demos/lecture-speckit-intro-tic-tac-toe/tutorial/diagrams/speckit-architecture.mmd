    CC["Claude Code<br/>/speckit-COMMAND arguments"]
    FJ[".specify/feature.json<br/>git-ignored pointer to the feature folder"]
    FEAT["specs/001-five-in-a-row/<br/>spec, CHANGELOG, plan, research, data-model,<br/>contracts/, quickstart, tasks, checklists/"]

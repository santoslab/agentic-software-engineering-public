    CC -- "loads" --> SK
    SK -- "python3 .specify/scripts/python/… --json" --> SCR
    SCR -- "reads" --> TPL
    SCR -- "reads / writes" --> FJ
    SCR -- "one JSON line: FEATURE_DIR, IMPL_PLAN, …" --> CC
    CC -- "reads" --> MEM
    CC -- "reads and writes" --> FEAT
    style CC fill:#310066,color:#ffffff,stroke:#310066
    style CLI fill:#ffffff

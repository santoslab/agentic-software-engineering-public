{
  "mcpServers": {
    "music": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "--directory", "${MUSIC_MCP_DIR}", "--frozen", "python", "launch_server.py"],
      "env": {
        "NEO4J_MCP_URI": "${MUSIC_DB_URI:-bolt://127.0.0.1:7687}",
        "NEO4J_MCP_USERNAME": "${MUSIC_DB_USER:-neo4j}",
        "NEO4J_MCP_PASSWORD": "${MUSIC_DB_PASSWORD}",
        "NEO4J_MCP_DATABASE": "neo4j"
      }
    }
  }
}
